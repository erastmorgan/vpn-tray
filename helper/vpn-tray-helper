#!/bin/bash
# SPDX-FileCopyrightText: 2026 erastmorgan
# SPDX-License-Identifier: MIT
# vpn-tray-helper — the ONLY thing vpn-tray runs as root (via sudoers NOPASSWD).
# Strict whitelist of actions, every argument is validated. Never prints keys.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

die() { echo "vpn-tray-helper: $*" >&2; exit 2; }

valid_iface() { [[ "$1" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || die "bad interface name: $1"; }
valid_ip()    { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || "$1" =~ ^[0-9A-Fa-f:]{2,39}$ ]] || die "bad ip: $1"; }

# kind -> systemd unit template / show tool / config dir
unit_of() {
  case "$1" in
    awg) echo "awg-quick@$2.service" ;;
    wg)  echo "wg-quick@$2.service" ;;
    *)   die "bad kind: $1" ;;
  esac
}
tool_of() { case "$1" in awg) echo awg ;; wg) echo wg ;; *) die "bad kind: $1" ;; esac; }
confdir_of() { case "$1" in awg) echo /etc/amnezia/amneziawg ;; wg) echo /etc/wireguard ;; *) die "bad kind: $1" ;; esac; }

action="${1:-}"; shift || true
case "$action" in
  up|down)
    [[ $# -eq 2 ]] || die "usage: $action awg|wg IFACE"
    valid_iface "$2"; unit="$(unit_of "$1" "$2")"
    [[ -f "$(confdir_of "$1")/$2.conf" ]] || die "no config for $2"
    if [[ $action == up ]]; then systemctl start "$unit"; else systemctl stop "$unit"; fi
    ;;
  show)
    # endpoints / handshakes / transfer only — no keys
    [[ $# -eq 2 ]] || die "usage: show awg|wg IFACE"
    valid_iface "$2"; t="$(tool_of "$1")"
    echo "endpoints";  "$t" show "$2" endpoints
    echo "handshakes"; "$t" show "$2" latest-handshakes
    echo "transfer";   "$t" show "$2" transfer
    ;;
  list-configs)
    # name<TAB>kind<TAB>endpoint for every awg/wg config (no secrets)
    for kind in awg wg; do
      d="$(confdir_of "$kind")"; [[ -d "$d" ]] || continue
      for f in "$d"/*.conf; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f" .conf)"
        ep="$(grep -iE '^\s*Endpoint\s*=' "$f" | head -1 | sed -E 's/^[^=]*=\s*//; s/\s+$//')" || true
        printf '%s\t%s\t%s\n' "$name" "$kind" "$ep"
      done
    done
    ;;
  dns-set)
    # dns-set IFACE IP [IP...] — registers nameservers with openresolv as exclusive
    [[ $# -ge 2 ]] || die "usage: dns-set IFACE IP..."
    iface="$1"; shift; valid_iface "$iface"
    for ip in "$@"; do valid_ip "$ip"; done
    command -v resolvconf >/dev/null || die "resolvconf not installed"
    printf 'nameserver %s\n' "$@" | resolvconf -a "vpntray.$iface" -m 0 -x
    ;;
  dns-clear)
    [[ $# -eq 1 ]] || die "usage: dns-clear IFACE"
    valid_iface "$1"
    command -v resolvconf >/dev/null || die "resolvconf not installed"
    resolvconf -d "vpntray.$1" -f
    ;;
  dns-base)
    # dns-base IP... — non-exclusive fallback resolver, used only when no VPN registered DNS.
    # Lets root-run VPN cores (Happ's xray) resolve their server while no tunnel is up;
    # the kill switch blocks DNS from non-root users outside the tunnel anyway.
    [[ $# -ge 1 ]] || die "usage: dns-base IP..."
    for ip in "$@"; do valid_ip "$ip"; done
    printf 'nameserver %s\n' "$@" | resolvconf -a vpntray.base -m 1000
    ;;
  killswitch-on)
    # killswitch-on LAN_CIDRS ENDPOINT...   (LAN_CIDRS: comma list; ENDPOINT: host or IPv4)
    [[ $# -ge 1 ]] || die "usage: killswitch-on LAN_CIDRS [ENDPOINT...]"
    lan="$1"; shift
    [[ "$lan" =~ ^([0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2},?)+$ ]] || die "bad lan list: $lan"
    declare -A ips=()
    for ep in "$@"; do
      if [[ "$ep" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
        ips[$ep]=1
      elif [[ "$ep" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$ ]]; then
        while read -r ip _; do [[ -n "$ip" ]] && ips[$ip]=1; done < <(getent ahostsv4 "$ep" | awk '{print $1}' | sort -u)
      else
        die "bad endpoint: $ep"
      fi
    done
    servers="$(IFS=,; echo "${!ips[*]}")"
    mkdir -p /etc/vpn-tray
    tmp="$(mktemp /etc/vpn-tray/.killswitch.XXXXXX)"
    {
      echo "# generated by vpn-tray-helper — internet only through a VPN"
      echo "table inet vpntray"
      echo "delete table inet vpntray"
      echo "table inet vpntray {"
      echo "  set lan4 { type ipv4_addr; flags interval; elements = { ${lan//,/, } } }"
      if [[ -n "$servers" ]]; then
        echo "  set servers4 { type ipv4_addr; elements = { ${servers//,/, } } }"
      else
        echo "  set servers4 { type ipv4_addr; }"
      fi
      cat <<'NFT'
  chain output {
    type filter hook output priority filter; policy accept;
    oifname "lo" accept
    oifname { "awg*", "wg*", "happ*", "tun*", "tap*", "ppp*", "tailscale*" } accept
    ip daddr @lan4 accept
    ip daddr @servers4 accept
    ip daddr { 224.0.0.0/4, 255.255.255.255 } accept
    udp sport 68 udp dport 67 accept
    meta skuid 0 meta l4proto { tcp, udp } th dport 53 accept
    ip6 daddr { fe80::/10, ff00::/8 } accept
    counter reject with icmpx admin-prohibited
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    oifname { "awg*", "wg*", "happ*", "tun*", "tap*", "ppp*", "tailscale*" } accept
    iifname { "awg*", "wg*", "happ*", "tun*", "tap*", "ppp*", "tailscale*" } accept
    ip daddr @lan4 accept
    ct state established,related accept
    counter reject with icmpx admin-prohibited
  }
}
NFT
    } > "$tmp"
    nft -c -f "$tmp" || { rm -f "$tmp"; die "nft check failed"; }
    nft -f "$tmp"
    mv -f "$tmp" /etc/vpn-tray/killswitch.nft
    echo "on servers=$servers"
    ;;
  killswitch-off)
    nft delete table inet vpntray 2>/dev/null || true
    rm -f /etc/vpn-tray/killswitch.nft
    echo off
    ;;
  killswitch-status)
    if nft list table inet vpntray >/dev/null 2>&1; then
      echo "on"; nft list set inet vpntray servers4 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u | tr '\n' ' '; echo
    else
      echo off
    fi
    ;;
  ping)
    echo ok
    ;;
  *)
    die "unknown action: '$action'"
    ;;
esac
